# JARVIS local configuration
# Copy this file to .env only when local overrides are needed.
# Never commit .env or place secrets in this file.

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_NUM_CTX=4096
OLLAMA_THINK=false

JARVIS_ENV=development
JARVIS_LOG_LEVEL=info
JARVIS_LOG_DIR=D:\AI\JarvisAgent\logs

JARVIS_WORKSPACE=D:\AI\JarvisWorkspace
JARVIS_EXPORTS=D:\AI\Exports
JARVIS_TEMP=D:\AI\Temp
